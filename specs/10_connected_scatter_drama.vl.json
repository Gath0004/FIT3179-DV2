{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Connected scatterplot: hours of new Australian TV drama vs money spent making it, free-to-air vs subscription/streaming, 2023/24 → 2024/25 (Screen Australia Drama Report). Dashed guides show cost per hour.",
  "width": "container",
  "height": 280,
  "layer": [
    {
      "data": {
        "values": [
          {
            "c": 0.5,
            "x": 0,
            "y": 0,
            "x2": 300,
            "y2": 150,
            "lab": "$0.5m per hour"
          },
          {
            "c": 1,
            "x": 0,
            "y": 0,
            "x2": 300,
            "y2": 300,
            "lab": "$1m per hour"
          },
          {
            "c": 2,
            "x": 0,
            "y": 0,
            "x2": 275,
            "y2": 550,
            "lab": "$2m per hour"
          },
          {
            "c": 5,
            "x": 0,
            "y": 0,
            "x2": 110,
            "y2": 550,
            "lab": "$5m per hour"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeDash": [
              3,
              4
            ],
            "color": "#c3c6d4"
          },
          "encoding": {
            "x": {
              "field": "x",
              "type": "quantitative"
            },
            "y": {
              "field": "y",
              "type": "quantitative"
            },
            "x2": {
              "field": "x2"
            },
            "y2": {
              "field": "y2"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -3,
            "dy": -6,
            "fontSize": 10,
            "color": "#8d91a8",
            "fontStyle": "italic"
          },
          "encoding": {
            "x": {
              "field": "x2",
              "type": "quantitative"
            },
            "y": {
              "field": "y2",
              "type": "quantitative"
            },
            "text": {
              "field": "lab"
            }
          }
        }
      ]
    },
    {
      "data": {
        "url": "data/drama_fta_vs_streaming.csv",
        "format": {
          "type": "csv",
          "parse": {
            "spend_m": "number",
            "hours": "number",
            "titles": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.spend_m / datum.hours",
          "as": "per_hour"
        },
        {
          "calculate": "datum.year == '2023/24' ? 0 : 1",
          "as": "step"
        }
      ],
      "encoding": {
        "x": {
          "field": "hours",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              300
            ]
          },
          "axis": {
            "title": "Hours of new drama made",
            "grid": false,
            "tickCount": 6,
            "titleColor": "#4f5563",
            "titleFontWeight": 500,
            "labelColor": "#4f5563",
            "domainColor": "#b9bbc7",
            "tickColor": "#b9bbc7",
            "format": "d",
            "values": [
              0,
              50,
              100,
              150,
              200,
              250,
              300
            ],
            "domain": true
          }
        },
        "y": {
          "field": "spend_m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              550
            ]
          },
          "axis": {
            "title": "Spent in Australia ($ million)",
            "grid": false,
            "gridColor": "#e8e9f0",
            "tickCount": 6,
            "titleColor": "#4f5563",
            "titleFontWeight": 500,
            "labelColor": "#4f5563",
            "domainColor": "#b9bbc7",
            "tickColor": "#b9bbc7",
            "format": "d",
            "values": [
              0,
              100,
              200,
              300,
              400,
              500
            ]
          }
        },
        "color": {
          "field": "platform",
          "type": "nominal",
          "scale": {
            "domain": [
              "Free-to-air TV",
              "Subscription TV & streaming"
            ],
            "range": [
              "#3A4E8C",
              "#E9B44C"
            ]
          },
          "legend": null
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "strokeWidth": 2.5
          },
          "encoding": {
            "order": {
              "field": "step"
            },
            "detail": {
              "field": "platform"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 120,
            "opacity": 1
          },
          "encoding": {
            "shape": {
              "condition": {
                "test": "datum.step == 1",
                "value": "triangle-left"
              },
              "value": "circle"
            },
            "opacity": {
              "condition": {
                "test": "datum.step == 1",
                "value": 1
              },
              "value": 0.45
            },
            "tooltip": [
              {
                "field": "platform",
                "title": "Platform"
              },
              {
                "field": "year",
                "title": "Financial year"
              },
              {
                "field": "spend_m",
                "title": "Spend ($m)"
              },
              {
                "field": "hours",
                "title": "Hours"
              },
              {
                "field": "titles",
                "title": "Titles"
              },
              {
                "field": "per_hour",
                "title": "Spend per hour ($m)",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "dy": -14,
            "fontSize": 11,
            "fontWeight": 600
          },
          "encoding": {
            "text": {
              "field": "year"
            },
            "color": {
              "condition": {
                "test": "datum.platform == 'Free-to-air TV'",
                "value": "#3A4E8C"
              },
              "value": "#8C6418"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "(datum.platform == 'Free-to-air TV' && datum.step == 1) || (datum.platform != 'Free-to-air TV' && datum.step == 0)"
            },
            {
              "calculate": "datum.platform == 'Free-to-air TV' ? 'Free-to-air TV' : 'Subscription & streaming'",
              "as": "name"
            }
          ],
          "mark": {
            "type": "text",
            "align": "center",
            "dx": 0,
            "dy": 26,
            "fontSize": 13,
            "fontWeight": 700
          },
          "encoding": {
            "text": {
              "field": "name"
            },
            "color": {
              "condition": {
                "test": "datum.platform == 'Free-to-air TV'",
                "value": "#3A4E8C"
              },
              "value": "#8C6418"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}