{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slopegraph: share of Australian adults using each way of watching in the previous 7 days, 2017 vs 2025 (ACMA).",
  "width": 455,
  "height": 420,
  "data": {
    "url": "data/acma_services_2017_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.year == 2025 ? (datum.service == 'YouTube' ? 58 : datum.service == 'Free-to-air TV (live)' ? 52.5 : datum.service == 'Netflix' ? 47.5 : datum.pct) : (datum.service == 'Paid streaming services' ? 31 : datum.service == 'Netflix' ? 26 : datum.pct)",
      "as": "label_y"
    },
    {
      "calculate": "datum.group == 'fta' ? (datum.service == 'Free-to-air TV (live)' ? 'Free-to-air live' : 'Free-to-air apps') : 'Online'",
      "as": "colour_key"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelFontWeight": 600,
        "domain": false,
        "ticks": false,
        "orient": "top"
      },
      "scale": {
        "type": "point",
        "range": [
          60,
          250
        ],
        "padding": 0
      }
    },
    "color": {
      "field": "colour_key",
      "type": "nominal",
      "scale": {
        "domain": [
          "Free-to-air live",
          "Free-to-air apps",
          "Online"
        ],
        "range": [
          "#3A4E8C",
          "#E86A4F",
          "#E9B44C"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#d9d4c7",
        "strokeDash": [
          2,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "color": {
          "value": "#d9d4c7"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "strokeCap": "round"
      },
      "encoding": {
        "y": {
          "field": "pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "labelColor": "#4f5563",
            "titleColor": "#4f5563",
            "titleFontWeight": 500,
            "domainColor": "#b9bbc7",
            "tickColor": "#b9bbc7",
            "title": "% of adults who used it in the past 7 days",
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "datum.value + '%'",
            "grid": true,
            "gridColor": "#ECE9F1",
            "domain": false,
            "ticks": false,
            "labelPadding": 4
          }
        },
        "detail": {
          "field": "service"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.15
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 70,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "pct",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "service",
            "title": "Service"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "pct",
            "title": "% of adults (last 7 days)"
          }
        ]
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "service"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2017"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": "d"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.2
        },
        "color": {
          "condition": [
            {
              "test": "datum.colour_key == 'Free-to-air live'",
              "value": "#3A4E8C"
            },
            {
              "test": "datum.colour_key == 'Free-to-air apps'",
              "value": "#B8432A"
            }
          ],
          "value": "#8C6418"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025"
        },
        {
          "calculate": "datum.pct + '%  ' + datum.service",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": 600,
        "limit": 200
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.2
        },
        "color": {
          "condition": [
            {
              "test": "datum.colour_key == 'Free-to-air live'",
              "value": "#3A4E8C"
            },
            {
              "test": "datum.colour_key == 'Free-to-air apps'",
              "value": "#B8432A"
            }
          ],
          "value": "#8C6418"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}