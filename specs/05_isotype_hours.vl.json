{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Isotype (pictogram) chart: average monthly hours of free-to-air TV per person by group, Jan–Jun 2026 (OzTAM VOZ). Each TV icon = about 5 hours a month.",
  "width": "container",
  "height": 240,
  "data": {
    "url": "data/voz_monthly_h1_2026.csv",
    "format": {
      "type": "csv",
      "parse": {
        "group_order": "number",
        "total_reach_pct": "number",
        "broadcast_reach_pct": "number",
        "bvod_reach_pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "toNumber(split(datum.total_time, ':')[0]) + toNumber(split(datum.total_time, ':')[1]) / 60",
      "as": "total_h"
    },
    {
      "calculate": "toNumber(split(datum.broadcast_time, ':')[0]) + toNumber(split(datum.broadcast_time, ':')[1]) / 60",
      "as": "broadcast_h"
    },
    {
      "calculate": "toNumber(split(datum.bvod_time, ':')[0]) + toNumber(split(datum.bvod_time, ':')[1]) / 60",
      "as": "bvod_h"
    },
    {
      "calculate": "round(datum.total_h / 5)",
      "as": "icons"
    },
    {
      "calculate": "datum.icons - round(datum.bvod_h / 5)",
      "as": "broadcast_icons"
    },
    {
      "calculate": "round(datum.total_h) + ' hrs'",
      "as": "label"
    },
    {
      "calculate": "sequence(0, datum.icons)",
      "as": "i"
    },
    {
      "flatten": [
        "i"
      ]
    },
    {
      "calculate": "datum.i < datum.broadcast_icons ? 'Broadcast (antenna)' : 'Streaming apps (BVOD)'",
      "as": "platform"
    },
    {
      "calculate": "datum.i * 5 + 2.5",
      "as": "xh"
    }
  ],
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "sort": {
        "field": "group_order"
      },
      "axis": {
        "title": null,
        "domain": false,
        "ticks": false,
        "labelFontSize": 12,
        "labelPadding": 10
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "M-1,-0.62 L1,-0.62 L1,0.42 L-1,0.42 Z M-0.42,0.52 L0.42,0.52 L0.42,0.66 L-0.42,0.66 Z",
        "size": {
          "expr": "min(150*pow(width/430,2),260)"
        },
        "strokeWidth": 0,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "xh",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              110
            ]
          },
          "axis": {
            "labelColor": "#4f5563",
            "titleColor": "#4f5563",
            "titleFontWeight": 500,
            "domainColor": "#b9bbc7",
            "tickColor": "#b9bbc7",
            "title": "Hours of free-to-air TV per person per month (1 icon = 5 hours)",
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ],
            "format": "d",
            "grid": true,
            "gridColor": "#ECE9F1",
            "domain": true
          }
        },
        "color": {
          "field": "platform",
          "type": "nominal",
          "scale": {
            "domain": [
              "Broadcast (antenna)",
              "Streaming apps (BVOD)"
            ],
            "range": [
              "#3A4E8C",
              "#E86A4F"
            ]
          },
          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square",
            "labelFontSize": 12,
            "labelLimit": 220
          }
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "total_time",
            "title": "Total per month (hh:mm)"
          },
          {
            "field": "broadcast_time",
            "title": "…on broadcast"
          },
          {
            "field": "bvod_time",
            "title": "…on streaming apps"
          }
        ],
        "opacity": {
          "condition": {
            "test": "sel_group == '' || datum.group == sel_group",
            "value": 1
          },
          "value": 0.25
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.i == datum.icons - 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": 500,
        "color": "#3b3b3b"
      },
      "encoding": {
        "x": {
          "field": "xh",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "opacity": {
          "condition": {
            "test": "sel_group == '' || datum.group == sel_group",
            "value": 1
          },
          "value": 0.3
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "sel_group",
      "value": ""
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}