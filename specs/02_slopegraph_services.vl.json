{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slopegraph: share of Australian adults using each way of watching in the previous 7 days, 2017 vs 2025 (ACMA).",
  "width": 455,
  "height": 420,
  "data": {
    "url": "data/acma_services_2017_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.year == 2025 ? (datum.service == 'YouTube' ? 58 : datum.service == 'Free-to-air TV (live)' ? 52.5 : datum.service == 'Netflix' ? 47.5 : datum.pct) : (datum.service == 'Paid streaming services' ? 31 : datum.service == 'Netflix' ? 26 : datum.pct)",
      "as": "label_y"
    },
    {
      "calculate": "datum.group == 'fta' ? (datum.service == 'Free-to-air TV (live)' ? 'Free-to-air live' : 'Free-to-air apps') : 'Online'",
      "as": "colour_key"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelFontWeight": 600,
        "domain": false,
        "ticks": false,
        "orient": "top"
      },
      "scale": {
        "type": "point",
        "range": [
          40,
          250
        ],
        "padding": 0
      }
    },
    "color": {
      "field": "colour_key",
      "type": "nominal",
      "scale": {
        "domain": [
          "Free-to-air live",
          "Free-to-air apps",
          "Online"
        ],
        "range": [
          "#00843D",
          "#c49a00",
          "#d9ab00"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#d9d4c7",
        "strokeDash": [
          2,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "color": {
          "value": "#d9d4c7"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "strokeCap": "round"
      },
      "encoding": {
        "y": {
          "field": "pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": null
        },
        "detail": {
          "field": "service"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.15
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 70,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "pct",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "service",
            "title": "Service"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "pct",
            "title": "% of adults (last 7 days)"
          }
        ]
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "service"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2017"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": "d"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.2
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025"
        },
        {
          "calculate": "datum.pct + '%  ' + datum.service",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": 600,
        "limit": 200
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.2
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}