{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap: average monthly reach of free-to-air TV by audience group and platform, Jan–Jun 2026 (OzTAM VOZ).",
  "data": {
    "url": "data/voz_monthly_h1_2026.csv",
    "format": {
      "type": "csv",
      "parse": {
        "group_order": "number",
        "total_reach_pct": "number",
        "broadcast_reach_pct": "number",
        "bvod_reach_pct": "number"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "total_reach_pct",
        "broadcast_reach_pct",
        "bvod_reach_pct"
      ],
      "as": [
        "measure",
        "reach"
      ]
    },
    {
      "calculate": "datum.measure == 'total_reach_pct' ? 'Any free-to-air TV' : datum.measure == 'broadcast_reach_pct' ? 'Broadcast (antenna)' : 'Streaming apps (BVOD)'",
      "as": "platform"
    },
    {
      "calculate": "toNumber(datum.reach)",
      "as": "reach"
    }
  ],
  "width": "container",
  "height": 260,
  "encoding": {
    "x": {
      "field": "platform",
      "type": "nominal",
      "sort": [
        "Any free-to-air TV",
        "Broadcast (antenna)",
        "Streaming apps (BVOD)"
      ],
      "axis": {
        "title": null,
        "orient": "top",
        "labelAngle": 0,
        "labelLimit": 110,
        "labelFontSize": 11,
        "labelFontWeight": 600,
        "domain": false,
        "ticks": false,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "group",
      "type": "nominal",
      "sort": {
        "field": "group_order"
      },
      "axis": {
        "title": null,
        "domain": false,
        "ticks": false,
        "labelFontSize": 12,
        "labelPadding": 8,
        "labelFontWeight": {
          "expr": "datum.value == sel_group ? 700 : 400"
        },
        "labelColor": {
          "expr": "datum.value == sel_group ? '#23263f' : '#4f5563'"
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 3,
        "stroke": "white",
        "strokeWidth": 3
      },
      "encoding": {
        "color": {
          "field": "platform",
          "type": "nominal",
          "scale": {
            "domain": [
              "Any free-to-air TV",
              "Broadcast (antenna)",
              "Streaming apps (BVOD)"
            ],
            "range": [
              "#23263f",
              "#3A4E8C",
              "#E86A4F"
            ]
          },
          "legend": null
        },
        "opacity": {
          "field": "reach",
          "type": "quantitative",
          "scale": {
            "domain": [
              50,
              100
            ],
            "range": [
              0.18,
              1
            ]
          },
          "legend": null
        },
        "stroke": {
          "condition": {
            "test": "datum.group == sel_group",
            "value": "#23263f"
          },
          "value": "white"
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "platform",
            "title": "Platform"
          },
          {
            "field": "reach",
            "title": "Monthly reach (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "reach",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "condition": {
            "test": "datum.reach > 70",
            "value": "white"
          },
          "value": "#23263f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "sel_group",
      "value": ""
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}