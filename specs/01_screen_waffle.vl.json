{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: share of video viewing on Australian TV sets, Q2 2026 (OzTAM Streamscape). Each square = 1% of viewing time.",
  "width": 318,
  "height": 318,
  "data": {
    "url": "data/streamscape_q2_2026.csv",
    "format": {
      "type": "csv",
      "parse": {
        "order": "number",
        "share_pct": "number",
        "cells": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "sequence(0, datum.cells)",
      "as": "cell"
    },
    {
      "flatten": [
        "cell"
      ]
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "idx"
        }
      ],
      "sort": [
        {
          "field": "order"
        }
      ]
    },
    {
      "calculate": "(datum.idx - 1) % 10",
      "as": "col"
    },
    {
      "calculate": "floor((datum.idx - 1) / 10)",
      "as": "row"
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 2,
    "stroke": "#06140c",
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "sort": {
        "field": "order"
      },
      "scale": {
        "domain": [
          "Free-to-air TV and its apps",
          "YouTube",
          "Other online video (Netflix, Stan, social, etc.)"
        ],
        "range": [
          "#3A4E8C",
          "#C98E1B",
          "#F1D08A"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "category",
        "title": "Type of viewing"
      },
      {
        "field": "share_pct",
        "title": "Share of TV-set viewing (%)",
        "format": ".1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "transparent"
  }
}