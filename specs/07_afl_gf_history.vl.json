{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Line + bar chart: national TV audience of the AFL Grand Final 2024–2026 alongside the number who watched on the 7plus streaming app (years where 7plus figures are published).",
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/afl_grand_final_audiences.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "national_audience": "number",
        "streaming_7plus": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year >= 2024"
    },
    {
      "calculate": "datum.national_audience / 1e6",
      "as": "aud_m"
    },
    {
      "calculate": "datum.streaming_7plus ? datum.streaming_7plus / 1e6 : null",
      "as": "stream_m"
    },
    {
      "calculate": "datum.streaming_7plus ? format(datum.streaming_7plus / datum.national_audience, '.0%') : 'not reported'",
      "as": "stream_share"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "title": "Year of Grand Final",
        "labelAngle": 0,
        "domain": true,
        "ticks": true,
        "labelFontSize": 12,
        "domainColor": "#b9bbc7",
        "tickColor": "#b9bbc7",
        "titleColor": "#4f5563",
        "titleFontWeight": 500
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#E86A4F",
        "cornerRadiusTopLeft": 2,
        "cornerRadiusTopRight": 2,
        "width": {
          "band": 0.42
        }
      },
      "encoding": {
        "y": {
          "field": "stream_m",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "streaming_7plus",
            "title": "Watched on 7plus streaming",
            "format": ","
          },
          {
            "field": "stream_share",
            "title": "Share of total audience"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#1B998B",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 70,
          "color": "#1B998B"
        }
      },
      "encoding": {
        "y": {
          "field": "aud_m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              5
            ]
          },
          "axis": {
            "title": "Average national audience (millions)",
            "grid": true,
            "gridColor": "#ECE9F1",
            "domain": false,
            "ticks": false,
            "tickCount": 5,
            "titleFontWeight": 500,
            "titleColor": "#4f5563",
            "format": "d",
            "values": [
              0,
              1,
              2,
              3,
              4,
              5
            ],
            "labelColor": "#4f5563",
            "domainColor": "#b9bbc7",
            "tickColor": "#b9bbc7"
          }
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "match",
            "title": "Match"
          },
          {
            "field": "national_audience",
            "title": "National audience",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#11695F"
      },
      "encoding": {
        "y": {
          "field": "aud_m",
          "type": "quantitative"
        },
        "text": {
          "field": "aud_m",
          "type": "quantitative",
          "format": ".2f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.stream_m"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -8,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#B8432A"
      },
      "encoding": {
        "y": {
          "field": "stream_m",
          "type": "quantitative"
        },
        "text": {
          "field": "stream_share"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}