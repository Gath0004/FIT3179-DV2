{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Diverging choropleth map: change in the NRL Grand Final TV audience in each capital-city market between 2025 (Brisbane Broncos v Melbourne Storm) and 2026 (Sydney Roosters v Newcastle Knights). Each state is shaded by its capital-city TV market.",
  "width": "container",
  "height": 470,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/aus_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ece6d8",
        "stroke": "#faf7f0",
        "strokeWidth": 1.2
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.name",
            "title": "State/territory"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/nrl_gf_city_2025_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "audience_2025": "number",
            "audience_2026": "number",
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "(datum.audience_2026 - datum.audience_2025) / datum.audience_2025",
          "as": "change"
        },
        {
          "calculate": "datum.audience_2026 - datum.audience_2025",
          "as": "diff"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/aus_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "states"
              }
            },
            "key": "properties.state"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape"
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "change",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.4,
              0,
              0.4
            ],
            "range": [
              "#4B5068",
              "#F1EFF5",
              "#8B5FBF"
            ],
            "clamp": true
          },
          "legend": {
            "title": "Change in NRL Grand Final audience, 2025 to 2026",
            "format": "+.0%",
            "orient": "bottom-left",
            "direction": "horizontal",
            "gradientLength": 200,
            "titleLimit": 320,
            "values": [
              -0.4,
              -0.2,
              0,
              0.2,
              0.4
            ]
          }
        },
        "tooltip": [
          {
            "field": "city",
            "title": "Capital-city TV market"
          },
          {
            "field": "audience_2025",
            "title": "2025 GF (Broncos v Storm)",
            "format": ","
          },
          {
            "field": "audience_2026",
            "title": "2026 GF (Roosters v Knights)",
            "format": ","
          },
          {
            "field": "change",
            "title": "Change",
            "format": "+.0%"
          }
        ],
        "stroke": {
          "condition": {
            "test": "datum.city == sel_city",
            "value": "#23263f"
          },
          "value": "#faf8f4"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.city == sel_city",
            "value": 3
          },
          "value": 1.2
        }
      }
    },
    {
      "data": {
        "url": "data/nrl_gf_city_2025_2026.csv",
        "format": {
          "type": "csv",
          "parse": {
            "audience_2025": "number",
            "audience_2026": "number",
            "lat": "number",
            "lon": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "(datum.audience_2026 - datum.audience_2025) / datum.audience_2025",
          "as": "change"
        },
        {
          "calculate": "(datum.change < 0 ? '−' : '+') + format(abs(datum.change), '.0%')",
          "as": "label"
        },
        {
          "calculate": "{'WA': [-26.5, 121.5], 'SA': [-30.0, 135.5], 'VIC': [-36.9, 144.2], 'NSW': [-32.2, 146.8], 'QLD': [-23.0, 145.0]}[datum.state]",
          "as": "pos"
        },
        {
          "calculate": "datum.pos[0]",
          "as": "lab_lat"
        },
        {
          "calculate": "datum.pos[1]",
          "as": "lab_lon"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 700
      },
      "encoding": {
        "longitude": {
          "field": "lab_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lab_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "condition": {
            "test": "datum.change < -0.15",
            "value": "white"
          },
          "value": "#23263f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lat": -17.8,
            "lon": 133.6,
            "t": "NT, Tas & ACT:"
          },
          {
            "lat": -19.2,
            "lon": 133.6,
            "t": "no capital-city"
          },
          {
            "lat": -20.6,
            "lon": 133.6,
            "t": "figures published"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 9.5,
        "fontStyle": "italic",
        "color": "#6b6b6b"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lat": -39.9,
            "lon": 146.4,
            "t": "Storm played 2025",
            "c": "ink",
            "dy": 0
          },
          {
            "lat": -24.6,
            "lon": 145.0,
            "t": "Broncos played 2025",
            "c": "white",
            "dy": 17
          },
          {
            "lat": -33.800000000000004,
            "lon": 146.8,
            "t": "Roosters, Knights 2026",
            "c": "#23263f",
            "dy": 17
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontStyle": "italic",
        "dy": 0
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t"
        },
        "color": {
          "condition": {
            "test": "datum.c == 'white'",
            "value": "white"
          },
          "value": "#23263f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "sel_city",
      "value": ""
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  }
}