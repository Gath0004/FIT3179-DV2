{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Marimekko (mosaic) chart: share of free-to-air TV minutes by platform (column width) and genre (segment height), Jan–Jun 2026 (OzTAM VOZ). The area of each block is its share of all free-to-air TV viewing time.",
  "width": "container",
  "height": 400,
  "data": {
    "url": "data/voz_genre_h1_2026.csv",
    "format": {
      "type": "csv",
      "parse": {
        "platform_share_of_minutes_pct": "number",
        "genre_share_pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "indexof(['News & current affairs', 'Sport', 'Drama', 'Reality TV', 'Light entertainment', 'Infotainment & lifestyle', 'Children\\'s', 'Documentary', 'Movies & mini-series', 'Comedy'], datum.genre)",
      "as": "genre_order"
    },
    {
      "stack": "genre_share_pct",
      "groupby": [
        "platform"
      ],
      "sort": [
        {
          "field": "genre_order",
          "order": "ascending"
        }
      ],
      "as": [
        "y0",
        "y1"
      ]
    },
    {
      "calculate": "datum.platform == 'Broadcast TV' ? 0 : 80.9 + 3",
      "as": "x0"
    },
    {
      "calculate": "datum.x0 + datum.platform_share_of_minutes_pct",
      "as": "x1"
    },
    {
      "calculate": "datum.platform_share_of_minutes_pct * datum.genre_share_pct / 100",
      "as": "share_of_all"
    },
    {
      "calculate": "(datum.x0 + datum.x1) / 2",
      "as": "xm"
    },
    {
      "calculate": "(datum.y0 + datum.y1) / 2",
      "as": "ym"
    },
    {
      "calculate": "{'News & current affairs':'News','Sport':'Sport','Drama':'Drama','Reality TV':'Reality','Light entertainment':'Light ent.','Infotainment & lifestyle':'Lifestyle','Children\\'s':'Children\\'s','Documentary':'Docos','Movies & mini-series':'Movies','Comedy':'Comedy'}[datum.genre]",
      "as": "short"
    },
    {
      "calculate": "datum.genre + '  ' + format(datum.genre_share_pct, '.1f') + '%'",
      "as": "label_long"
    },
    {
      "calculate": "datum.short + ' ' + format(datum.genre_share_pct, '.1f') + '%'",
      "as": "label_short"
    }
  ],
  "encoding": {
    "x": {
      "field": "x0",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          103
        ]
      },
      "axis": {
        "labelColor": "#4f5563",
        "titleColor": "#4f5563",
        "titleFontWeight": 500,
        "domainColor": "#b9bbc7",
        "tickColor": "#b9bbc7",
        "title": "Cumulative share of all free-to-air viewing minutes (%): broadcast column, then apps column",
        "values": [
          0,
          20,
          40,
          60,
          83.9,
          103
        ],
        "format": "d",
        "orient": "bottom",
        "grid": false,
        "labelExpr": "datum.value > 81 ? (datum.value > 101 ? '100' : '80.9') : datum.label",
        "domain": false
      }
    },
    "y": {
      "field": "y0",
      "type": "quantitative",
      "scale": {
        "domain": [
          -9,
          100
        ],
        "reverse": true
      },
      "axis": {
        "labelColor": "#4f5563",
        "titleColor": "#4f5563",
        "titleFontWeight": 500,
        "domainColor": "#b9bbc7",
        "tickColor": "#b9bbc7",
        "title": "Share of the platform's minutes (%)",
        "values": [
          0,
          20,
          40,
          60,
          80,
          100
        ],
        "format": "d",
        "grid": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#faf7f0",
        "strokeWidth": 2
      },
      "encoding": {
        "x2": {
          "field": "x1"
        },
        "y2": {
          "field": "y1"
        },
        "color": {
          "field": "genre",
          "type": "nominal",
          "scale": {
            "domain": [
              "News & current affairs",
              "Sport",
              "Drama",
              "Reality TV",
              "Light entertainment",
              "Infotainment & lifestyle",
              "Children's",
              "Documentary",
              "Movies & mini-series",
              "Comedy"
            ],
            "range": [
              "#23263f",
              "#6E7191",
              "#B56576",
              "#9AA0B8",
              "#C9CBD8",
              "#D3D5E0",
              "#BFC2D1",
              "#DCDDE6",
              "#CDD0DC",
              "#E4E5EC"
            ]
          },
          "legend": null
        },
        "opacity": {
          "condition": {
            "param": "genre_hover",
            "empty": true,
            "value": 1
          },
          "value": 0.35
        },
        "tooltip": [
          {
            "field": "platform",
            "title": "Platform"
          },
          {
            "field": "genre",
            "title": "Genre"
          },
          {
            "field": "genre_share_pct",
            "title": "% of this platform's minutes",
            "format": ".1f"
          },
          {
            "field": "share_of_all",
            "title": "% of ALL free-to-air TV minutes",
            "format": ".1f"
          }
        ]
      },
      "params": [
        {
          "name": "genre_hover",
          "select": {
            "type": "point",
            "fields": [
              "genre"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.platform == 'Broadcast TV' && datum.genre_share_pct >= 4"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "align": "center"
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "field": "ym",
          "type": "quantitative"
        },
        "text": {
          "field": "label_long"
        },
        "color": {
          "condition": {
            "test": "indexof(['News & current affairs', 'Sport', 'Drama'], datum.genre) >= 0",
            "value": "white"
          },
          "value": "#26313d"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.platform != 'Broadcast TV' && datum.genre_share_pct >= 4"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": 600,
        "align": "center"
      },
      "encoding": {
        "x": {
          "field": "xm",
          "type": "quantitative"
        },
        "y": {
          "field": "ym",
          "type": "quantitative"
        },
        "text": {
          "field": "label_short"
        },
        "color": {
          "condition": {
            "test": "indexof(['News & current affairs', 'Sport', 'Drama'], datum.genre) >= 0",
            "value": "white"
          },
          "value": "#26313d"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "hx": 40.45,
            "hl": "BROADCAST TV · 80.9% OF MINUTES",
            "hy": -4.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 700,
        "baseline": "middle",
        "color": "#3A4E8C",
        "clip": false,
        "letterSpacing": 1
      },
      "encoding": {
        "x": {
          "field": "hx",
          "type": "quantitative"
        },
        "y": {
          "field": "hy",
          "type": "quantitative"
        },
        "text": {
          "field": "hl"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "hx": 93.45,
            "hl": "APPS · 19.1%",
            "hy": -4.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 700,
        "baseline": "middle",
        "color": "#B8432A",
        "clip": false,
        "letterSpacing": 1
      },
      "encoding": {
        "x": {
          "field": "hx",
          "type": "quantitative"
        },
        "y": {
          "field": "hy",
          "type": "quantitative"
        },
        "text": {
          "field": "hl"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 82.4,
            "y": -9,
            "y2": 100
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#23263f",
        "strokeWidth": 2,
        "strokeDash": [
          6,
          4
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "y2": {
          "field": "y2"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": {
    "top": 8,
    "left": 5,
    "right": 5,
    "bottom": 5
  }
}